# Token que te da @BotFather
TOKEN=123456789:AAAA-sustituye-por-tu-token
# Nombre que aparece en /help (el nombre visible en Telegram se pone en BotFather)
BOT_NAME=PunsBot
# Votos necesarios para activar una rima añadida (en grupos de ese tamaño o más)
REQUIRED_VALIDATIONS=5
# Ruta de la base de datos SQLite
DBLOCATION=./data/punsdb.db
